{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "One published event row. Every value is a string and every key is always present; an unknown field is \"\", never null and never missing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "date",
    "end",
    "time",
    "title",
    "venue",
    "city",
    "status",
    "url",
    "venue_id",
    "city_id",
    "artist_ids"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "end": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
    "time": { "type": "string", "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d)?$" },
    "title": { "type": "string", "minLength": 1 },
    "venue": { "type": "string" },
    "city": { "type": "string" },
    "status": { "type": "string" },
    "url": { "type": "string" },
    "venue_id": { "type": "string", "pattern": "^[a-z0-9-]*$" },
    "city_id": { "type": "string", "pattern": "^[a-z0-9-]*$" },
    "artist_ids": {
      "type": "string",
      "pattern": "^([a-z0-9-]+(,[a-z0-9-]+)*)?$",
      "description": "Comma-separated Artist ids, in the order the title named them."
    }
  }
}
