{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venue.schema.json",
  "title": "Venue",
  "description": "A room or building events happen in. `city` is \"\" when no source has named one yet; `lat`, `lon` and `address` are \"\" until an event at the venue states them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "city", "city_id"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "city": { "type": "string" },
    "city_id": { "type": "string", "pattern": "^[a-z0-9-]*$" },
    "lat": { "$ref": "event.schema.json#/properties/lat" },
    "lon": { "$ref": "event.schema.json#/properties/lon" },
    "address": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
